# Copy to .env.local (gitignored) and fill in real values. This .env.example holds
# PLACEHOLDERS ONLY and is safe to commit. Never put secrets in NEXT_PUBLIC_* vars
# or anywhere client-visible.

# ─── tawk.to live chat (PUBLIC widget identifiers — not secret) ─────────────
# Find these in tawk.to Dashboard → Administration → Chat Widget (embed code:
# https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>). The widget only renders when
# NEXT_PUBLIC_TAWK_PROPERTY_ID is set.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# ─── WhatsApp lead notifications (SERVER-SIDE ONLY — never NEXT_PUBLIC) ──────
# Base URL of the WhatsApp bot's VPS backend. MUST be https:// in production so
# visitor PII is never sent over plain HTTP. e.g. https://bot.towingno1.com
WHATSAPP_BACKEND_URL=
# HMAC-SHA256 shared secret; MUST match WHATSAPP_NOTIFICATION_TOKEN on the VPS.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_NOTIFICATION_TOKEN=
# Optional per-request timeout (ms) for the VPS call. Default 3000.
WHATSAPP_NOTIFY_TIMEOUT_MS=
# Optional: allow an http://localhost backend for LOCAL DEV ONLY. Never in prod.
WHATSAPP_NOTIFY_ALLOW_INSECURE=

# ─── tawk.to webhook (supplementary fallback; SERVER-SIDE ONLY) ─────────────
# Secret from the tawk.to webhook settings; used to verify X-Tawk-Signature.
TAWK_WEBHOOK_SECRET=
# "true" lets the webhook send a fallback notification (pop-out / failed callback).
# Default off to avoid duplicating the pre-chat lead.
TAWK_WEBHOOK_NOTIFY_FALLBACK=

# ─── Best-effort rate limits on the public routes (optional) ────────────────
# NOTE: in-memory limits are per-serverless-instance and NOT globally reliable;
# the authoritative limits live on the VPS bot. See the runbook.
CHAT_RATE_LIMIT=5
CHAT_RATE_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT=60

# ─── Existing vars (already in .env.local; listed for completeness) ─────────
# RESEND_API_KEY=
# RESEND_DOMAIN=towingno1.com
# EMAIL_FROM=info
# EMAIL_DISPATCH=dispatch
# EMAIL_REPLY_TO=info
# EMAIL_ADMIN=info@towingno1.com
# RECAPTCHA_SECRET_KEY=
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
